# Keep the build context small and avoid leaking host state / secrets.
_build/
deps/
.git/
.gitignore
.elixir_ls/
.fetch
erl_crash.dump
*.ez

# Node / asset build artifacts (assets are rebuilt inside the image).
assets/node_modules/

# Digested static output is regenerated by `mix assets.deploy` in the builder.
priv/static/assets/
priv/static/cache_manifest.json

# Tests and docs are not needed to build the prod release.
test/
doc/

# Never ship local env / secret files.
*.secret.exs
.env
.env.*

# Deployment tooling is not part of the image build context.
deploy/
README.md
DECISIONS.md
Makefile
