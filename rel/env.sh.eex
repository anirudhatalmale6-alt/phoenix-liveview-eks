#!/bin/sh
# Runtime environment for the release, sourced by bin/demo before boot.
#
# Node naming for clustering / distributed Erlang. In Kubernetes each pod gets a
# unique IP; we name the node after it so `libcluster` (or manual clustering) can
# form a mesh for cross-pod Phoenix.PubSub and Presence. Harmless when running a
# single node. RELEASE_NODE/RELEASE_DISTRIBUTION are honoured by the release.
if [ -n "${POD_IP:-}" ]; then
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="demo@${POD_IP}"
fi
